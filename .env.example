# ---------------------------------------------------------------------------
# Asana Ortho Inventory Manager — environment variables
# Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# Postgres connection string (Prisma).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asana_ortho?schema=public"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used in emails to build links back to a request.
# Falls back to NEXTAUTH_URL when unset.
APP_URL="http://localhost:3000"

# Email delivery (Resend). If RESEND_API_KEY is unset, emails are logged to the
# server console instead of being sent — handy for local development.
RESEND_API_KEY=""
EMAIL_FROM="Asana Ortho Procurement <procurement@example.com>"

# Secret the daily cron job must send in the `x-cron-secret` header to invoke
# /api/cron/reminders. Generate with: openssl rand -hex 24
CRON_SECRET="replace-with-a-cron-secret"

# Default password for the seeded demo users (staff + admin).
SEED_USER_PASSWORD="password123"
